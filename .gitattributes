# Auto-normalize line endings to LF
* text=auto eol=lf

# Text files explicitly LF
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.geojson text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
